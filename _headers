# Cloudflare Pages response headers. The site is native ES modules with no build step and no
# hashed file names, so a stale module next to a fresh one breaks an import and the page dies.
# Everything is revalidated on every load (ETags make that a 304, not a download); Pages purges
# its edge on deploy, so this is about the browser's cache.
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/api/*
  Cache-Control: no-store

# The content security policy (2026-10-29). Everything the page runs or loads is its own, except the
# weather, which is Open-Meteo: scripts and the terrain worker from here only, no inline script (the
# loading screen's is src/loading.js), styles and fonts from here (the hands are in assets/fonts/),
# images from here plus data: and blob: for a poster pixelated in the browser before it is pinned and
# the browser-only board's pictures, sounds from here, connections to here and api.open-meteo.com.
# No framing by anyone, no plugins, no <base>. Pages does not put these on a Function's response,
# which is fine: the Functions answer JSON and PNG, never a page.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://api.open-meteo.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
